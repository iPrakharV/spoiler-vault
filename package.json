{
  "name": "spoiler-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "replay": "tsx server/replay.ts",
    "eval": "tsx eval/run.ts",
    "test": "tsx --test server/tests/*.test.ts",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:auto": "node scripts/verify-auto.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.64.1",
    "tsx": "^4.20.2",
    "typescript": "^5.8.3"
  }
}
